---
/**
 * Product card. Zero chrome: no border, no radius, no shadow.
 *
 * Verified across Seiko, G-Shock and Goldsmiths - every credible watch
 * retailer computes to exactly that. Rounded, shadowed cards are the single
 * loudest dropshipper tell.
 *
 * Three lines, no marketing adjectives. Strings like "Luxury Elegant Fashion
 * Quartz" read as counterfeit listing copy because that is where they come
 * from. The manufacturer reference is the highest-density authenticity signal
 * available and costs one field.
 */
import { Picture } from 'astro:assets';
import BrandName from './BrandName.astro';
import { productImage } from '../lib/images.js';

interface Props {
  product: {
    slug: string;
    brand: string;
    model: string;
    reference: string;
    brandLatin: string;
    brandFa: string;
    caseSize?: number;
  };
}
const { product: p } = Astro.props;
const img = productImage(p.slug);
---

<article data-card class="lift group bg-plate">
  <a href={`${import.meta.env.BASE_URL}watch/${p.slug}/`} class="block p-4">
    <!-- 1:1 so an uneven set of supplier photos still grids perfectly.
         Ragged card heights are an instant credibility loss. -->
    <div class="relative aspect-square overflow-hidden bg-[#eeeeeb]">
      {
        img ? (
          <Picture
            src={img}
            alt={`ساعت ${p.brandFa} مدل ${p.reference}`}
            widths={[240, 360, 480]}
            sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 240px"
            formats={['avif', 'webp']}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        ) : (
          <div class="absolute inset-0 flex items-center justify-center text-plate-muted">
            <span class="label">NO PHOTO YET</span>
          </div>
        )
      }
    </div>

    <p class="mt-3">
      <span class="label text-[10px] text-plate-muted">
        <BrandName name={p.brandLatin} />
      </span>
    </p>
    <p class="mt-1 text-sm text-plate-ink">{p.model}</p>
    <p class="mt-1">
      <span class="reference text-xs text-plate-muted">{p.reference}</span>
    </p>
    <p class="mt-2 text-xs text-plate-muted">تماس بگیرید</p>
  </a>
</article>
