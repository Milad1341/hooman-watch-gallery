---
/**
 * Footer. Repeats the full name, address and phone.
 *
 * Instagram is linked but never embedded - an embed hard-fails behind the
 * filternet and blanks a whole section.
 */
import Mark from './Mark.astro';
import Phone from './Phone.astro';
import { toPersianDigits } from '../lib/normalize.js';
import { SHOP } from '../data/shop.js';
---

<footer class="border-t border-hairline">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <Mark class="w-8 text-ink" />
        <span class="text-base">{SHOP.nameFa}</span>
      </div>
      <p class="mt-4 text-sm text-muted">نمایندگی رسمی سیکو، سیتیزن و کاسیو</p>
    </div>

    <div>
      <p><span class="label text-[11px] text-muted">تماس</span></p>
      <ul class="mt-3 space-y-1">
        {SHOP.phones.map((p) => (
          <li>
            <Phone national={p.national} display={p.display} class="text-ink" />
          </li>
        ))}
      </ul>
      <p class="mt-4">
        <a
          href={`https://www.instagram.com/${SHOP.instagram}/`}
          rel="noopener"
          class="text-muted transition-colors duration-200 ease-out hover:text-ink"
        >
          اینستاگرام گالری
        </a>
      </p>
    </div>

    <div>
      <p><span class="label text-[11px] text-muted">آدرس</span></p>
      <p class="mt-3 text-sm text-muted">{SHOP.address.fa}</p>
      <p class="mt-4"><span class="label text-[11px] text-muted">ساعت کاری</span></p>
      <p class="mt-2 text-sm text-muted">
        هر روز هفته،
        {SHOP.hours.map((h, i) => (
          <>
            {i > 0 && ' و '}
            <span class="ltr-num">{toPersianDigits(h.opens)}</span> تا <span class="ltr-num">{toPersianDigits(h.closes)}</span>
          </>
        ))}
      </p>
    </div>
  </div>
</footer>
