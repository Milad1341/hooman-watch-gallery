---
/**
 * The hero: a working watch dial built from the logo's own geometry.
 *
 * There is no shop photography and the owner did not want any, so the hero has
 * to be designed rather than shot. This makes the brand mark itself the hero -
 * the same squircle, the same 12 indices, the same 2.45:1 quarter-to-baton
 * ratio - blown up to fill the screen and given hands that actually move.
 *
 * THE DETAIL THAT MATTERS: a mechanical watch at 28,800 vph advances its
 * seconds hand in exactly 8 discrete steps per second, 125ms apart. Not a
 * smooth sweep, which reads as a render. Not a 1-second tick, which reads as
 * cheap quartz. Eight steps reads as a MOVEMENT, and anyone who knows watches
 * clocks it within two seconds. That is the whole idea.
 *
 * ACCESSIBILITY: WCAG 2.2.2 is Level A and applies to anything that
 * auto-starts, runs over five seconds, and sits alongside other content, with
 * no exemption for decoration. So the hand runs for a few seconds on load and
 * stops, at a real time. It is a watch in a display case, not a clock.
 *
 * COST: pure inline SVG plus a CSS keyframe. No image, no JavaScript, no
 * request. It renders in the first paint on a throttled connection, which is
 * the only kind this audience has.
 */

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const S = 1000;
const C = S / 2;
const R = 500;

// Same proportions as the mark. See scripts/build-logo.mjs.
const INDEX_INNER = 0.67 * R;
const INDEX_OUTER = 0.9 * R;
const QUARTER_DEG = 7.1;
const BATON_DEG = 2.9;

const rad = (d: number) => ((d - 90) * Math.PI) / 180;
const pt = (r: number, deg: number) => [C + r * Math.cos(rad(deg)), C + r * Math.sin(rad(deg))];
const f = (n: number) => Number(n.toFixed(2));

function indexPath(deg: number, widthDeg: number) {
  const h = widthDeg / 2;
  const p = [
    pt(INDEX_INNER, deg - h),
    pt(INDEX_OUTER, deg - h),
    pt(INDEX_OUTER, deg + h),
    pt(INDEX_INNER, deg + h),
  ];
  return `M${p.map(([x, y]) => `${f(x)},${f(y)}`).join('L')}Z`;
}

// Squircle, same 0.22 corner ratio as the mark.
const sq = (() => {
  const r = 0.22 * S;
  const k = r * 0.55;
  return [
    `M${f(r)},0`, `L${f(S - r)},0`,
    `C${f(S - r + k)},0 ${f(S)},${f(r - k)} ${f(S)},${f(r)}`,
    `L${f(S)},${f(S - r)}`,
    `C${f(S)},${f(S - r + k)} ${f(S - r + k)},${f(S)} ${f(S - r)},${f(S)}`,
    `L${f(r)},${f(S)}`,
    `C${f(r - k)},${f(S)} 0,${f(S - r + k)} 0,${f(S - r)}`,
    `L0,${f(r)}`,
    `C0,${f(r - k)} ${f(r - k)},0 ${f(r)},0`,
    'Z',
  ].join('');
})();
const squircle = sq;

const indices = Array.from({ length: 12 }, (_, i) => ({
  d: indexPath(i * 30, i % 3 === 0 ? QUARTER_DEG : BATON_DEG),
  quarter: i % 3 === 0,
}));

// The dial rests at 10:10. It is the industry convention because it frames the
// logo and lifts the face, and every catalogue photograph in the world uses it.
const HOUR_DEG = (10 % 12) * 30 + 10 * 0.5; // 305
const MIN_DEG = 10 * 6; // 60
---

<div class:list={['hero-dial', className]} aria-hidden="true">
  <svg viewBox={`0 0 ${S} ${S}`} fill="none">
    <!-- The squircle. Without it the dial reads as a generic clock instead of
         this shop's mark, which is the entire point of using it as the hero. -->
    <path d={squircle} class="case" />

    <!-- indices, same geometry as the mark -->
    {
      indices.map((ix) => (
        <path d={ix.d} class={ix.quarter ? 'ix ix-q' : 'ix'} />
      ))
    }

    <!-- hour and minute hands, resting at 10:10 -->
    <g transform={`rotate(${HOUR_DEG} ${C} ${C})`}>
      <rect x={C - 9} y={C - 210} width="18" height="240" class="hand" rx="2" />
    </g>
    <g transform={`rotate(${MIN_DEG} ${C} ${C})`}>
      <rect x={C - 6} y={C - 300} width="12" height="330" class="hand" rx="2" />
    </g>

    <!-- the seconds hand: 8 discrete steps per second, then it stops -->
    <g class="seconds" style={`transform-origin:${C}px ${C}px`}>
      <rect x={C - 2} y={C - 330} width="4" height="400" class="hand-sec" />
      <circle cx={C} cy={C} r="14" class="hand-sec" />
    </g>

    <circle cx={C} cy={C} r="7" class="pinion" />
  </svg>
</div>

<style>
  .hero-dial {
    /* The dial is atmosphere, not content. It sits behind the words and never
       competes with them. */
    pointer-events: none;
    user-select: none;
  }

  .hero-dial svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The case reads as a faint edge, enough to say "this is the mark" without
     competing with the headline that sits over it. */
  .case {
    fill: var(--color-panel);
    stroke: var(--color-hairline);
    stroke-width: 2;
  }

  .ix {
    fill: var(--color-hairline);
  }

  /* Quarters catch a little more light, exactly as on a real dial. */
  .ix-q {
    fill: color-mix(in srgb, var(--color-muted) 45%, transparent);
  }

  .hand {
    fill: color-mix(in srgb, var(--color-muted) 55%, transparent);
  }

  /* The seconds hand is the ONLY place the accent appears outside a CTA.
     It earns it: lume is the one glow a watch legitimately owns, and this is
     the moving part. */
  .hand-sec {
    fill: var(--color-accent);
  }

  .pinion {
    fill: var(--color-shell);
    stroke: var(--color-muted);
    stroke-width: 3;
  }

  /* 28,800 vph = 8 steps per second, 125ms apart.
     Runs for 4 seconds and stops, staying under the WCAG 2.2.2 five-second
     threshold for auto-starting motion. */
  .seconds {
    animation: tick 4s steps(32, end) 1 both;
  }

  @keyframes tick {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(24deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seconds {
      animation: none;
      transform: rotate(24deg);
    }
  }
</style>
