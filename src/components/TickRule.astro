---
/**
 * A section divider made from the mark's own index ticks.
 *
 * The tick is the atomic graphic element of this identity - it is already
 * load-bearing in the logo, so reusing it costs nothing and gives the site a
 * signature no competitor can copy without copying the mark.
 *
 * Quarters are wider than batons, exactly as on the dial.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const ticks = Array.from({ length: 12 }, (_, i) => i % 3 === 0);
---

<div class:list={['flex items-center justify-center gap-3', className]} aria-hidden="true">
  {
    ticks.map((isQuarter) => (
      <span
        class:list={[
          'inline-block bg-hairline',
          isQuarter ? 'h-3 w-[3px]' : 'h-2 w-px',
        ]}
      />
    ))
  }
</div>
