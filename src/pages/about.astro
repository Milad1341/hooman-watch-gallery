---
/**
 * About. Countable facts, not slogans.
 *
 * Numbers are checkable and adjectives are not, which is exactly why numbers
 * read as authentic in a market where everyone claims to be original.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CallBar from '../components/CallBar.astro';
import TickRule from '../components/TickRule.astro';
import Phone from '../components/Phone.astro';
import { SHOP, primaryPhone } from '../data/shop.js';
import { brands } from '../lib/catalogue.js';

const facts = [
  ['۱۶', 'سال در همین آدرس'],
  ['۱۴', 'برند در گالری'],
  ['۴', 'برند با نمایندگی رسمی'],
  ['۱۰۰۰+', 'مدل موجود در مغازه'],
];
---

<Base
  title={`درباره گالری ساعت هومن | نمایندگی رسمی سیکو، سیتیزن و کاسیو`}
  description="گالری ساعت هومن از سال ۱۳۸۹ در شهرک اکباتان تهران. نمایندگی رسمی سیکو، سیتیزن و کاسیو."
>
  <SiteHeader />

  <main class="mx-auto max-w-6xl px-6 py-14">
    <h1 class="text-3xl">درباره گالری</h1>

    <p class="mt-6 max-w-[46rem] text-lg">
      از سال ۱۳۸۹ در شهرک اکباتان ساعت می‌فروشیم. همین یک مغازه، همین یک آدرس.
    </p>

    <ul class="reveal-stagger mt-12 grid grid-cols-2 gap-px bg-hairline lg:grid-cols-4">
      {
        facts.map(([n, t]) => (
          <li class="bg-shell px-6 py-8">
            <p class="text-4xl">{n}</p>
            <p class="mt-2 text-sm text-muted">{t}</p>
          </li>
        ))
      }
    </ul>

    <TickRule class="my-16" />

    <section class="reveal grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-2xl">نمایندگی رسمی یعنی چه</h2>
        <p class="mt-4 text-muted">
          ما فروشنده‌ی مجاز سیکو، سیتیزن، کاسیو و جی شاک هستیم. ساعتی که می‌خرید از مسیر رسمی
          وارد شده است و گارانتی آن از طرف نمایندگی همان برند در ایران ارائه می‌شود، نه از طرف
          مغازه.
        </p>
      </div>
      <div>
        <h2 class="text-2xl">چرا قیمت روی سایت نیست</h2>
        <p class="mt-4 text-muted">
          بازار ساعت روزانه تغییر می‌کند. اگر قیمتی روی سایت بگذاریم، تا چند روز دیگر درست
          نیست. مدلی که می‌پسندید را ببینید و زنگ بزنید تا قیمت امروز را بگوییم.
        </p>
      </div>
    </section>

    <TickRule class="my-16" />

    <section class="reveal">
      <h2 class="text-2xl">برندهایی که داریم</h2>
      <p class="mt-6 max-w-[46rem] text-muted">
        {brands.map((b, i) => (
          <>
            {i > 0 && '، '}
            <a href={`${import.meta.env.BASE_URL}brand/${b.key}/`} class="text-ink hover:text-accent">{b.fa}</a>
          </>
        ))}
      </p>
    </section>

    <section class="reveal mt-16 border-t border-hairline pt-10">
      <h2 class="text-2xl">آدرس و تماس</h2>
      <p class="mt-4 text-lg">{SHOP.address.fa}</p>
      <p class="mt-6">
        <Phone
          national={primaryPhone.national}
          display={primaryPhone.display}
          label="تماس با گالری"
          class="press inline-flex min-h-[54px] items-center gap-3 bg-accent px-7 text-on-accent"
        />
      </p>
    </section>
  </main>

  <SiteFooter />
  <CallBar />
</Base>
