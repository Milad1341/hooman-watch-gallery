---
/**
 * The catalogue.
 *
 * Filtering is client-side over a prebuilt index. At this scale Array.filter
 * is the whole feature - no search library. See CLAUDE.md section 3.5.
 *
 * IMPORTANT: filtering degrades gracefully. Without JavaScript every product
 * is still rendered and reachable, and the brand pages provide a second route.
 * A share of this audience is on a degraded connection.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CallBar from '../components/CallBar.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, brands, GENDERS, SHAPES, catalogueUpdated } from '../lib/catalogue.js';
import { SHOP } from '../data/shop.js';

const genderOrder = ['men', 'women', 'set', 'unisex'];
const shapeOrder = ['round', 'square', 'rectangle', 'oval'];

// Only offer a facet value that actually returns something.
const has = (key, v) => products.some((p) => p[key] === v);
---

<Base
  title={`مجموعه ساعت‌ها | ${SHOP.nameFa}`}
  description="مجموعه‌ای از ساعت‌های اصل سیکو، سیتیزن، کاسیو، تایمکس و برندهای دیگر در گالری ساعت هومن، شهرک اکباتان."
>
  <SiteHeader />

  <main class="mx-auto max-w-6xl px-6 py-14">
    <header>
      <h1 class="text-3xl">مجموعه ساعت‌ها</h1>
      <p class="mt-4 max-w-[46rem] text-muted">
        این بخشی از مدل‌هایی است که در گالری داریم. بیش از ۱۰۰۰ مدل در مغازه موجود است؛ برای
        دیدن همه‌ی مدل‌ها تماس بگیرید یا حضوری تشریف بیاورید.
      </p>
    </header>

    <!-- Filters. `data-filter` is read by the inline script below. -->
    <div class="mt-10 space-y-5" data-filters>
      <div>
        <p><span class="label text-[10px] text-muted">برند</span></p>
        <div class="mt-2 flex flex-wrap gap-2">
          <button data-filter="brand" data-value="" class="chip is-on" type="button">همه</button>
          {
            brands
              .filter((b) => has('brand', b.key))
              .map((b) => (
                <button data-filter="brand" data-value={b.key} class="chip" type="button">
                  {b.fa}
                </button>
              ))
          }
        </div>
      </div>

      <div>
        <p><span class="label text-[10px] text-muted">دسته</span></p>
        <div class="mt-2 flex flex-wrap gap-2">
          <button data-filter="gender" data-value="" class="chip is-on" type="button">همه</button>
          {
            genderOrder
              .filter((g) => has('gender', g))
              .map((g) => (
                <button data-filter="gender" data-value={g} class="chip" type="button">
                  {GENDERS[g]}
                </button>
              ))
          }
        </div>
      </div>

      <div>
        <!-- Case SHAPE, not diameter. Torob ranks it fourth in its live filter
             set; Iranians filter by shape where Westerners filter by size. -->
        <p><span class="label text-[10px] text-muted">فرم صفحه</span></p>
        <div class="mt-2 flex flex-wrap gap-2">
          <button data-filter="caseShape" data-value="" class="chip is-on" type="button">همه</button>
          {
            shapeOrder
              .filter((s) => has('caseShape', s))
              .map((s) => (
                <button data-filter="caseShape" data-value={s} class="chip" type="button">
                  {SHAPES[s]}
                </button>
              ))
          }
        </div>
      </div>

      <div>
        <label class="block">
          <span class="label text-[10px] text-muted">جستجو</span>
          <input
            type="search"
            data-search
            placeholder="نام برند، مدل یا کد محصول"
            class="mt-2 w-full max-w-sm border border-control bg-panel px-4 py-3 text-ink placeholder:text-muted focus:border-accent focus:outline-none"
          />
        </label>
      </div>
    </div>

    <p class="mt-8 text-sm text-muted">
      <span data-count>{products.length}</span> مدل نمایش داده می‌شود
    </p>

    <ul class="reveal-stagger mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" data-grid>
      {
        products.map((p) => (
          <li
            data-product
            data-brand={p.brand}
            data-gender={p.gender}
            data-caseshape={p.caseShape}
            data-blob={p.blob}
          >
            <ProductCard product={p} />
          </li>
        ))
      }
    </ul>

    <!-- Real empty state, with the phone number in it. -->
    <div data-empty hidden class="mt-10 border border-hairline p-10 text-center">
      <p class="text-lg">چیزی با این فیلترها پیدا نشد.</p>
      <p class="mt-3 text-muted">
        بیش از ۱۰۰۰ مدل در مغازه داریم که همه‌شان روی سایت نیستند. زنگ بزنید تا ببینیم چه
        داریم.
      </p>
      <p class="mt-6">
        <a href="tel:+982144697309" class="press inline-flex min-h-[52px] items-center bg-accent px-7 text-on-accent">
          تماس با گالری
        </a>
      </p>
    </div>

    <p class="mt-12 text-xs text-muted">
      آخرین بروزرسانی فهرست: <span class="ltr-num">{catalogueUpdated}</span>
    </p>
  </main>

  <SiteFooter />
  <CallBar />
</Base>

<style>
  .chip {
    border: 1px solid var(--color-control);
    padding: 0.5rem 1rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    min-height: 40px;
    transition:
      color 200ms ease-out,
      border-color 200ms ease-out,
      background-color 200ms ease-out;
  }

  .chip:hover {
    color: var(--color-ink);
  }

  /* Active state uses the accent, which is the one non-CTA place it is allowed:
     it marks the thing the user just did. */
  .chip.is-on {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>

<script>
  // Progressive enhancement: everything is already rendered and visible. This
  // only hides things. With JS off the full catalogue is still browsable.
  const grid = document.querySelector('[data-grid]');
  const items = [...document.querySelectorAll('[data-product]')];
  const countEl = document.querySelector('[data-count]');
  const emptyEl = document.querySelector('[data-empty]');
  const search = document.querySelector('[data-search]');

  const state = { brand: '', gender: '', caseShape: '', q: '' };

  // Must match src/lib/normalize.js. Kept in sync deliberately: inlining it
  // avoids shipping a module for nine lines, but if norm() changes, change it
  // here too. The tests in normalize.test.js define the contract.
  const norm = (s) =>
    String(s ?? '')
      .replace(/[يى]/g, 'ی')
      .replace(/ك/g, 'ک')
      .replace(/[​-‍﻿]/g, ' ')
      .replace(/[۰-۹]/g, (d) => String(d.charCodeAt(0) - 0x06f0))
      .replace(/[٠-٩]/g, (d) => String(d.charCodeAt(0) - 0x0660))
      .toLowerCase()
      .replace(/[^\p{L}\p{N}\s]/gu, ' ')
      .replace(/\s+/g, ' ')
      .trim();

  function apply() {
    const q = norm(state.q);
    const tokens = q ? q.split(' ') : [];
    let shown = 0;

    for (const li of items) {
      const okBrand = !state.brand || li.dataset.brand === state.brand;
      const okGender = !state.gender || li.dataset.gender === state.gender;
      const okShape = !state.caseShape || li.dataset.caseshape === state.caseShape;
      const blob = li.dataset.blob ?? '';
      const okQuery = tokens.every((t) => blob.includes(t));
      const show = okBrand && okGender && okShape && okQuery;
      li.hidden = !show;
      if (show) shown++;
    }

    if (countEl) countEl.textContent = new Intl.NumberFormat('fa-IR').format(shown);
    if (emptyEl) emptyEl.hidden = shown !== 0;
    if (grid) grid.hidden = shown === 0;

    // Filter state in the URL, so a filtered view can be sent over WhatsApp.
    const params = new URLSearchParams();
    for (const [k, v] of Object.entries(state)) if (v) params.set(k, v);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  for (const btn of document.querySelectorAll('[data-filter]')) {
    btn.addEventListener('click', () => {
      const key = btn.dataset.filter;
      state[key] = btn.dataset.value;
      for (const sib of document.querySelectorAll(`[data-filter="${key}"]`)) {
        sib.classList.toggle('is-on', sib === btn);
      }
      apply();
    });
  }

  search?.addEventListener('input', (e) => {
    state.q = e.target.value;
    apply();
  });

  // Restore from the URL so a shared link opens the same view.
  const initial = new URLSearchParams(location.search);
  for (const key of ['brand', 'gender', 'caseShape']) {
    const v = initial.get(key);
    if (!v) continue;
    state[key] = v;
    for (const sib of document.querySelectorAll(`[data-filter="${key}"]`)) {
      sib.classList.toggle('is-on', sib.dataset.value === v);
    }
  }
  if (initial.get('q') && search) {
    search.value = initial.get('q');
    state.q = initial.get('q');
  }
  if ([...initial].length) apply();
</script>
