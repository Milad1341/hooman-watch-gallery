---
/**
 * Phase 02 design preview.
 *
 * Every token, both grounds, all type roles, the card, the tick primitives and
 * the CTA on one page. Review and approve this BEFORE building features - it is
 * far cheaper to reject a palette here than after fifty components exist.
 *
 * Not linked from anywhere. Delete before launch, or leave it as living
 * documentation of the system.
 */
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import TickRule from '../components/TickRule.astro';
import Phone from '../components/Phone.astro';
import BrandName from '../components/BrandName.astro';
import { primaryPhone } from '../data/shop.js';

const tokens = [
  ['--color-shell', '#0b0c0d', 'page ground', ''],
  ['--color-panel', '#15171a', 'raised surface', ''],
  ['--color-ink', '#e9eaec', 'body text', '16.26:1 AAA'],
  ['--color-muted', '#8b9095', 'secondary text', '6.08:1 AA'],
  ['--color-plate', '#f7f7f5', 'the lit vitrine', '18.25:1 vs shell'],
  ['--color-plate-ink', '#12161c', 'text on plate', '16.92:1 AAA'],
  ['--color-accent', '#a8d94a', 'lume, CTA only', '11.83:1 AAA'],
  ['--color-hairline', '#24272b', 'decorative rules only', '1.31:1 not for controls'],
  ['--color-control', '#6b7178', 'control boundaries', '3.97:1 meets 1.4.11'],
];

const cards = [
  { brand: 'SEIKO', fa: 'سیکو', model: 'Presage Cocktail Time', ref: 'SRPB41J1' },
  { brand: 'CITIZEN', fa: 'سیتیزن', model: 'Eco-Drive Titanium', ref: 'BM8560-88' },
  { brand: 'G-SHOCK', fa: 'جی شاک', model: 'GA-2100', ref: 'GA2100-1A1' },
  { brand: 'Q&Q', fa: 'کیو اند کیو', model: 'Superior', ref: 'S21A-00' },
];
---

<Base title="Design preview - Phase 02">
  <main class="mx-auto max-w-5xl px-6 py-16">
    <header class="flex items-center gap-5">
      <Mark class="w-14 text-ink" />
      <div>
        <h1 class="text-3xl">سیستم طراحی</h1>
        <p class="mt-1"><span class="label text-[11px] text-muted">Phase 02 design preview</span></p>
      </div>
    </header>

    <TickRule class="my-12" />

    <!-- The mark -->
    <section>
      <h2 class="text-xl">نشان</h2>
      <div class="mt-6 flex flex-wrap items-end gap-8">
        {[96, 64, 40, 24].map((s) => (
          <div class="text-center">
            <Mark class="text-ink" style={`width:${s}px`} />
            <p class="mt-2"><span class="label text-[10px] text-muted">{s}</span></p>
          </div>
        ))}
        <div class="text-center">
          <Mark simple class="text-ink" style="width:16px" />
          <p class="mt-2"><span class="label text-[10px] text-muted">16 simple</span></p>
        </div>
        <div class="bg-plate p-4 text-center">
          <Mark class="text-plate-ink" style="width:40px" />
          <p class="mt-2"><span class="label text-[10px] text-plate-muted">on plate</span></p>
        </div>
      </div>
      <p class="mt-6 max-w-[60ch] text-muted">
        همان نشان، فقط با تغییر رنگ متن. هیچ رنگی داخل خود فایل نیست.
      </p>
    </section>

    <TickRule class="my-12" />

    <!-- Tokens -->
    <section>
      <h2 class="text-xl">رنگ‌ها</h2>
      <div class="mt-6 grid gap-px bg-hairline sm:grid-cols-2">
        {
          tokens.map(([name, hex, use, ratio]) => (
            <div class="flex items-center gap-4 bg-shell p-4">
              <div
                class="h-12 w-12 shrink-0 border border-control"
                style={`background:${hex}`}
              />
              <div class="min-w-0">
                <p><span class="label text-[11px]">{name}</span></p>
                <p class="text-sm text-muted">
                  {use} <span class="ltr-num">{hex}</span>
                </p>
                {ratio && <p><span class="label text-[10px] text-muted">{ratio}</span></p>}
              </div>
            </div>
          ))
        }
      </div>
      <p class="mt-6 max-w-[62ch] text-muted">
        رنگ تاکیدی فقط روی دکمه‌ی تماس و حالت فعال. هیچ‌جای دیگر.
      </p>
    </section>

    <TickRule class="my-12" />

    <!-- Type -->
    <section>
      <h2 class="text-xl">تایپوگرافی</h2>
      <div class="mt-6 space-y-6">
        <div>
          <p><span class="label text-[10px] text-muted">display 600</span></p>
          <p class="text-4xl">گالری ساعت هومن</p>
        </div>
        <div>
          <p><span class="label text-[10px] text-muted">body 400 / line-height 1.8</span></p>
          <p class="max-w-[62ch]">
            نمایندگی رسمی سیکو، سیتیزن و کاسیو. بیش از ۱۰۰۰ مدل ساعت در مغازه موجود است.
            برای قیمت و موجودی تماس بگیرید یا حضوری تشریف بیاورید.
          </p>
        </div>
        <div>
          <p><span class="label text-[10px] text-muted">latin label, mono, 0.1em tracking</span></p>
          <p><span class="label">CERTIFIED RESELLER</span></p>
        </div>
        <div>
          <p><span class="label text-[10px] text-muted">reference, mono, ltr isolated</span></p>
          <p><span class="reference text-lg">SRPB41J1</span></p>
        </div>
      </div>
    </section>

    <TickRule class="my-12" />

    <!-- Cards on the plate -->
    <section>
      <h2 class="text-xl">کارت محصول</h2>
      <p class="mt-2 max-w-[62ch] text-muted">
        اتاق تاریک، ویترین روشن. عکس‌ها روی زمینه‌ی روشن می‌نشینند.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {
          cards.map((c) => (
            <article data-card class="bg-plate p-4">
              <div class="aspect-square bg-[#efefec]" />
              <p class="mt-3">
                <span class="label text-[10px] text-plate-muted">
                  <BrandName name={c.brand} />
                </span>
              </p>
              <p class="mt-1 text-sm text-plate-ink">{c.model}</p>
              <p class="mt-1">
                <span class="reference text-xs text-plate-muted">{c.ref}</span>
              </p>
              <p class="mt-2 text-xs text-plate-muted">تماس بگیرید</p>
            </article>
          ))
        }
      </div>
      <p class="mt-4 text-sm text-muted">
        بدون گوشه‌ی گرد، بدون سایه، بدون حاشیه. سه سطر: برند، مدل، کد.
      </p>
    </section>

    <TickRule class="my-12" />

    <!-- CTA -->
    <section>
      <h2 class="text-xl">دکمه‌ی تماس</h2>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a
          href={`tel:+98${primaryPhone.national.replace(/^0/, '')}`}
          class="inline-flex min-h-[52px] items-center gap-3 bg-accent px-6 text-on-accent transition-[background-color,transform] duration-200 ease-out active:scale-[0.98]"
        >
          <span>تماس با گالری</span>
          <span class="ltr-num font-mono">۰۲۱-۴۴۶۹۷۳۰۹</span>
        </a>
        <a
          href="#"
          class="inline-flex min-h-[52px] items-center border border-control px-6 text-ink transition-colors duration-200 ease-out"
        >
          دیدن مجموعه
        </a>
      </div>
      <p class="mt-4 max-w-[62ch] text-sm text-muted">
        شماره داخل دکمه چاپ شده، نه پشت یک برچسب. ارتفاع ۵۲ پیکسل برای انگشت.
      </p>
    </section>

    <TickRule class="my-12" />

    <section>
      <h2 class="text-xl">عناصر تکرارشونده</h2>
      <ul class="mt-6 space-y-3">
        {
          ['اصالت کالا', 'گارانتی از طرف برند', 'تعمیر و تعویض باتری'].map((t) => (
            <li class="flex items-center gap-3">
              <span class="inline-block h-4 w-1 shrink-0 bg-accent" />
              <span>{t}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-muted">
        همان شاخص روی نشان، به عنوان جداکننده و نشانه‌ی فهرست.
      </p>
      <p class="mt-6"><Phone national={primaryPhone.national} display={primaryPhone.display} class="text-accent" /></p>
    </section>
  </main>
</Base>
